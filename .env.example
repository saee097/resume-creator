# Database connection for Prisma (PostgreSQL).
# For a local file DB, switch the provider in prisma/schema.prisma to "sqlite"
# and use: DATABASE_URL="file:./dev.db"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resumeforge?schema=public"

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Public base URL of the app (used for OAuth redirects).
APP_URL="http://localhost:3000"

# Seed: email of the user that should receive the admin role.
ADMIN_EMAIL="admin@example.com"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/oauth/callback/google"

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:3000/api/auth/oauth/callback/github"
